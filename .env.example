# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
LOG_LEVEL=INFO
DATA_DIR=./data

# Model layer: Ollama on the GPU box. In production use its Tailscale IP, e.g.
# OLLAMA_URL=http://100.x.y.z:11434 (MagicDNS names do not resolve inside containers)
MODELS_CONFIG=config/models.yaml
AGENTS_CONFIG=config/agents.yaml
OLLAMA_URL=http://localhost:11434
# Google Gemini: one or more API keys, comma-separated (requests rotate across them)
GEMINI_API_KEYS=

# Public API admin key: python -m app.cli secret
# Client app keys are created with: python -m app.cli keys create <label>
ADMIN_API_KEY=

# Background tasks. Webhooks are signed with X-Devagent-Signature: sha256=HMAC(body)
WEBHOOK_SECRET=
WORKER_CONCURRENCY=1
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF=5

# Sandbox (docker = isolated container; local = NO isolation, dev only)
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=devagent-sandbox:latest
SANDBOX_CPUS=1
SANDBOX_MEMORY=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_TIMEOUT=120
SANDBOX_MAX_OUTPUT=20000
# Domains the http_get tool may fetch (subdomains included)
HTTP_ALLOWLIST=stacklogic.pl,nexum-holding.at,nexum-holding.pl,pypi.org,docs.python.org,github.com

# Approvals for risky actions (git push, rm, deploy, ...). Answer via POST /v1/approvals/{id}
APPROVAL_MODE=risky
APPROVAL_TIMEOUT=600
# Your bot receives {"event": "approval.requested", ...} here and asks you TAK/NIE
APPROVAL_WEBHOOK_URL=

# Memory: embeddings via Ollama (`ollama pull nomic-embed-text`) or "hash" (no model)
MEMORY_EMBEDDER=ollama
EMBED_MODEL=nomic-embed-text
MEMORY_REFLECT=true
MEMORY_TOP_K=3
MEMORY_MIN_RATING=4

# Learning cycle (see training/README.md)
EVAL_CONFIG=config/eval.yaml
LEARNING_MIN_SCORE=0.5

# Production (deploy/vps): public HTTPS domain for the API (DNS A record -> VPS IP)
DOMAIN=

# Operator: the host worker (worker/operator_worker.py) controls YOUR computer.
# Same token on the VPS and in the worker's config. Generate: python -m app.cli secret
OPERATOR_WORKER_TOKEN=

# Email connector (optional) - gives the secretary a real inbox. Use an app password.
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_PORT=587

# Invoicing: your company details printed as the seller (one line, or use \n)
COMPANY_SELLER=

# Telegram channel (optional): Jarvis answers your messages. Create a bot via @BotFather.
# Set the webhook: POST https://api.telegram.org/bot<TOKEN>/setWebhook
#   url=https://ai.example.com/v1/telegram/webhook  secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHATS=
