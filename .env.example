# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
LOG_LEVEL=INFO
DATA_DIR=./data

# Model layer: Ollama on the GPU box (reached via WireGuard/Tailscale tunnel)
MODELS_CONFIG=config/models.yaml
AGENTS_CONFIG=config/agents.yaml
OLLAMA_URL=http://localhost:11434

# Public API admin key: python -m app.cli secret
# Client app keys are created with: python -m app.cli keys create <label>
ADMIN_API_KEY=
